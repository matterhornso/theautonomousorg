# ────────────────────────────────────────────────────────────────────────────
# .env.example — TheAutonomous.org
#
# Copy this file to .env.local for local dev, or paste each KEY=VALUE pair into
# your deploy provider (Railway / Vercel / Fly) for production.
#
# Tiers below mirror the go-live TODO. Tier 1 alone runs the app locally with
# mocks; later tiers progressively unlock real features.
# ────────────────────────────────────────────────────────────────────────────


# ── Tier 1 · Auth ───────────────────────────────────────────────────────────
# Source: https://dashboard.clerk.com → your instance → API keys.
# Use TEST keys (pk_test_..., sk_test_...) for local dev, LIVE keys (pk_live_,
# sk_live_) only in production. Same .env structure for both.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/admin


# ── Tier 2 · Database ───────────────────────────────────────────────────────
# When DATABASE_URL is unset, the app falls back to SQLite (better-sqlite3) at
# ./local.db. With it set, the app routes through src/lib/db-postgres.ts and
# requires migrations 001-004 applied + the `vector` extension installed.
#
# Supabase: Project Settings → Database → Connection string (use the "Session
# pooler" URI for serverless / Vercel; "Transaction pooler" for long-lived
# Node servers; raw direct URI only for migrations).
#
# pgvector: Database → Extensions → enable `vector`.
DATABASE_URL=

# Optional: 32-byte AES key for encrypting per-firm secrets in the vault.
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=


# ── Tier 3 · Agents ─────────────────────────────────────────────────────────
# Anthropic — used by src/lib/agent-runner.ts for Claude tool-use loop.
# Source: https://console.anthropic.com → API keys.
ANTHROPIC_API_KEY=

# Cohere — used by src/lib/vault.ts for `embed-multilingual-v3.0` (1024 dim).
# Source: https://dashboard.cohere.com → API keys.
COHERE_API_KEY=

# OpenAI — optional fallback embeddings + non-Anthropic models.
OPENAI_API_KEY=


# ── Tier 4 · Messaging (WhatsApp via Gupshup BSP) ──────────────────────────
# Account: https://www.gupshup.io/whatsapp-business-platform — note that BSP
# approval / number registration with Meta has 1-3 day lead time.
GUPSHUP_API_KEY=
GUPSHUP_APP_NAME=
GUPSHUP_SOURCE_NUMBER=

# Webhook signing — paste the same value into Gupshup's webhook config UI so
# the route handler can verify HMAC of inbound messages.
# Generate with: openssl rand -hex 32
WHATSAPP_WEBHOOK_SECRET=
WHATSAPP_CALLBACK_SECRET=

# Telegram — alternate messaging bridge. Used by /admin/timesheets reminder
# loop (Client 1) and the agent-conversation bridge.
# 1. Telegram → @BotFather → /newbot → copy the token.
# 2. Generate webhook secret: openssl rand -hex 32
# 3. After deploying, register the webhook by POSTing to:
#    https://api.telegram.org/bot<TOKEN>/setWebhook
#    with body { url: "<APP_BASE_URL>/api/messaging/telegram", secret_token: "<TELEGRAM_WEBHOOK_SECRET>" }
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=


# ── Tier 5 · Other integrations + ops ──────────────────────────────────────
# Tally on-prem agent ingest token (mTLS bearer).
TALLY_INGEST_TOKEN=

# Shopify (Client 2 — getsoma.store).
#
# Shopify deprecated static admin tokens in 2026. Apps now live in the Dev
# Dashboard (admin.shopify.com → Settings → Apps → Develop apps → "Build apps
# in Dev Dashboard"). The merchant's app gives a Client ID + Client Secret;
# the runtime exchanges them for a 24h access token via the client
# credentials grant. We cache the token in-process until ~5 min before expiry.
#
# Required scopes on the app: write_products, write_inventory, read_publications
# (write_* implies read_*).
#
# Note: the app and the store must belong to the same Shopify organization
# for the client credentials grant to work.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2026-04

# Cron — protects /api/cron/* endpoints. Pass as `?token=<value>` or
# `Authorization: Bearer <value>`. Generate with: openssl rand -hex 32
CRON_SECRET=

# Toggle self-serve provisioning in /api/companies. Default off — set to "true"
# only after you've smoke-tested the provisioner path.
PROVISIONER_SELF_SERVE=false

# Stripe billing.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_GROWTH_PRICE_ID=
STRIPE_ENTERPRISE_PRICE_ID=

# Email — used by Resend for transactional notifications and inbound parsing.
RESEND_API_KEY=

# Inbound email webhook secret. Set this when configuring Resend inbound
# (e.g. agents@theautonomous.org) to point at /api/messaging/email. Resend
# echoes this in the x-resend-secret header on every delivery; the route
# rejects requests that don't match.
RESEND_INBOUND_SECRET=

# Deepgram — transcribes audio uploaded to /api/memory/ingest/audio. Powers
# the conversation capture half of the v3 knowledge graph (the writer that
# fills persons/conversations/decisions/commitments). Without this key the
# endpoint returns 503; the rest of the platform is unaffected.
DEEPGRAM_API_KEY=

# Fireflies.ai GraphQL API key — powers POST /api/memory/ingest/fireflies, which
# pulls meeting transcripts into the company brain (deduped on conversations.source_ref).
# Single-tenant v1 (one global key); move to a per-firm `integrations` row when
# onboarding a second firm. Without this key the endpoint returns 503.
FIREFLIES_API_KEY=

# Public-facing base URL of your deployment. Used to build callback URLs in
# WhatsApp templates and email content.
NEXT_PUBLIC_APP_URL=http://localhost:3007
APP_BASE_URL=http://localhost:3007

# Internal-only secret for cross-service calls (agent runner → callback API).
# Generate with: openssl rand -hex 32
INTERNAL_SECRET=
